{
  "name": "forma",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:docker": "docker compose up",
    "dev:docker:build": "docker compose up --build",
    "dev:mobile": "pnpm --filter @forma/mobile dev",
    "dev:mobile:web": "pnpm --filter @forma/mobile dev:web",
    "dev:portal": "pnpm --filter @forma/web-portal dev",
    "lint": "node ./node_modules/@biomejs/biome/bin/biome check .",
    "format": "node ./node_modules/@biomejs/biome/bin/biome format --write .",
    "check-types": "turbo run check-types",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup:cloud": "bash ./scripts/setup-cloud-env.sh",
    "postgres:dev": "bash ./scripts/start-postgres-dev.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "@types/react": "~19.0.10",
      "react-native": "0.79.6"
    }
  }
}
