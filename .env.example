# Local development — copy to .env (gitignored) for pnpm db:* and host apps.
# Backend stack: `pnpm dev:docker` (Postgres + API with OAUTH_MOCK).
# Mobile: separate terminal — `pnpm dev:mobile` (simulator) or `pnpm dev:mobile:web`.

DATABASE_URL=postgresql://forma:forma@localhost:5432/forma
REDIS_URL=redis://localhost:6379

# API (required when running @forma/api outside Docker)
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-secret-change-in-production
EMAIL_PROVIDER=mock
OAUTH_MOCK=true
OAUTH_MOBILE_SUCCESS_URL=forma://oauth

# Leave OAuth client IDs unset for local mock login.
# If GOOGLE_CLIENT_ID is set without OAUTH_MOCK=true, dev mock login and OAuth buttons fail.
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# FACEBOOK_CLIENT_ID=

# Mobile (Expo — host terminal)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_OAUTH_SUCCESS_URL=forma://oauth
