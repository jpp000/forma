generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model PlatformHealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("platform_health_checks")
}

model IdentityUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions           IdentitySession[]
  oauthAccounts      IdentityOAuthAccount[]
  studentProfile     StudentProfile?
  trainingRestDays   ProgressTrainingRestDay[]

  @@map("identity_users")
}

model IdentityOtpToken {
  id        String    @id @default(cuid())
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("identity_otp_tokens")
}

model IdentitySession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_sessions")
}

model IdentityOAuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("identity_oauth_accounts")
}

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  age            Int
  sex            String
  heightCm       Float    @map("height_cm")
  activityLevel  String   @map("activity_level")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       IdentityUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthGoal StudentHealthGoal?

  @@map("student_profiles")
}

model StudentHealthGoal {
  id               String   @id @default(cuid())
  studentProfileId String   @unique @map("student_profile_id")
  goalType         String   @map("goal_type")
  targetWeightKg   Float?   @map("target_weight_kg")
  targetCalories   Int?     @map("target_calories")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("student_health_goals")
}

model TrainingExercise {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  muscleGroup String   @map("muscle_group")
  equipment   String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planItems        TrainingWorkoutPlanItem[]
  sessionExercises TrainingWorkoutSessionExercise[]

  @@index([userId])
  @@map("training_exercises")
}

model TrainingWorkoutPlan {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items    TrainingWorkoutPlanItem[]
  sessions TrainingWorkoutSession[]

  @@index([userId])
  @@map("training_workout_plans")
}

model TrainingWorkoutPlanItem {
  id          String @id @default(cuid())
  planId      String @map("plan_id")
  exerciseId  String @map("exercise_id")
  sets        Int
  reps        Int
  restSeconds Int    @map("rest_seconds")
  sortOrder   Int    @default(0) @map("sort_order")

  plan     TrainingWorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise TrainingExercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("training_workout_plan_items")
}

model TrainingWorkoutSession {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  planId      String?  @map("plan_id")
  completedAt DateTime @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  plan      TrainingWorkoutPlan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  exercises TrainingWorkoutSessionExercise[]

  @@index([userId, completedAt])
  @@map("training_workout_sessions")
}

model TrainingWorkoutSessionExercise {
  id         String @id @default(cuid())
  sessionId  String @map("session_id")
  exerciseId String @map("exercise_id")
  sets       Json

  session  TrainingWorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise TrainingExercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("training_workout_session_exercises")
}

model NutritionMealLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mealType  String   @map("meal_type")
  logDate   DateTime @map("log_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items NutritionMealItem[]

  @@unique([userId, mealType, logDate])
  @@index([userId, logDate])
  @@map("nutrition_meal_logs")
}

model NutritionMealItem {
  id       String @id @default(cuid())
  mealLogId String @map("meal_log_id")
  name     String
  calories Float
  protein  Float
  carbs    Float
  fat      Float

  mealLog NutritionMealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  @@index([mealLogId])
  @@map("nutrition_meal_items")
}

model NutritionPlan {
  id                 String   @id @default(cuid())
  studentUserId      String   @map("student_user_id")
  professionalUserId String   @map("professional_user_id")
  dailyCalories      Int      @map("daily_calories")
  dailyProtein       Float    @map("daily_protein")
  dailyCarbs         Float    @map("daily_carbs")
  dailyFat           Float    @map("daily_fat")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([studentUserId])
  @@map("nutrition_plans")
}

model ProgressWeightEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  weightKg  Float    @map("weight_kg")
  logDate   DateTime @map("log_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, logDate])
  @@index([userId, logDate])
  @@map("progress_weight_entries")
}

model ProgressStreak {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  streakType     String    @map("streak_type")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActiveDate DateTime? @map("last_active_date") @db.Date
  graceWeekKey   String?   @map("grace_week_key")
  graceGapsUsed  Int       @default(0) @map("grace_gaps_used")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, streakType])
  @@map("progress_streaks")
}

model ProgressTrainingRestDay {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  restDate  DateTime @map("rest_date") @db.Date
  source    String   @default("explicit")
  createdAt DateTime @default(now()) @map("created_at")

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restDate])
  @@index([userId, restDate])
  @@map("progress_training_rest_days")
}

model CoachingProfessionalProfile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  type        String
  credentials String
  displayName String?  @map("display_name")
  bio         String?
  slug        String?  @unique
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("coaching_professional_profiles")
}

model CoachingInvite {
  id                 String    @id @default(cuid())
  professionalUserId String    @map("professional_user_id")
  studentEmail       String    @map("student_email")
  token              String    @unique
  expiresAt          DateTime  @map("expires_at")
  acceptedAt         DateTime? @map("accepted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([studentEmail])
  @@map("coaching_invites")
}

model CoachingLink {
  id                 String   @id @default(cuid())
  professionalUserId String   @map("professional_user_id")
  studentUserId      String   @map("student_user_id")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([professionalUserId, studentUserId])
  @@index([professionalUserId])
  @@map("coaching_links")
}

model CoachingLinkRequest {
  id                 String    @id @default(cuid())
  professionalUserId String    @map("professional_user_id")
  studentUserId      String    @map("student_user_id")
  status             String // pending | accepted | declined | expired
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")

  @@index([professionalUserId, status])
  @@index([studentUserId, status])
  @@map("coaching_link_requests")
}

model BillingPlan {
  id         String @id @default(cuid())
  slug       String @unique
  name       String
  priceCents Int    @map("price_cents")
  features   Json

  subscriptions BillingSubscription[]

  @@map("billing_plans")
}

model BillingSubscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  planId               String    @map("plan_id")
  status               String
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  plan BillingPlan @relation(fields: [planId], references: [id])

  @@map("billing_subscriptions")
}
