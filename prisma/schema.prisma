generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformHealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("platform_health_checks")
}

model IdentityUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions      IdentitySession[]
  oauthAccounts IdentityOAuthAccount[]
  studentProfile StudentProfile?

  @@map("identity_users")
}

model IdentityOtpToken {
  id        String    @id @default(cuid())
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("identity_otp_tokens")
}

model IdentitySession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("identity_sessions")
}

model IdentityOAuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("identity_oauth_accounts")
}

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  age            Int
  sex            String
  heightCm       Float    @map("height_cm")
  activityLevel  String   @map("activity_level")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       IdentityUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthGoal StudentHealthGoal?

  @@map("student_profiles")
}

model StudentHealthGoal {
  id               String   @id @default(cuid())
  studentProfileId String   @unique @map("student_profile_id")
  goalType         String   @map("goal_type")
  targetWeightKg   Float?   @map("target_weight_kg")
  targetCalories   Int?     @map("target_calories")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("student_health_goals")
}

model TrainingExercise {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  muscleGroup String   @map("muscle_group")
  equipment   String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("training_exercises")
}
