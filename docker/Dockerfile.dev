FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

ENV CI=true
ENV PNPM_NODE_LINKER=hoisted
ENV DATABASE_URL=postgresql://forma:forma@postgres:5432/forma

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc turbo.json prisma.config.ts ./
COPY apps/api/package.json ./apps/api/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/worker/package.json ./apps/worker/
COPY packages/types/package.json ./packages/types/
COPY packages/config/package.json ./packages/config/

RUN pnpm install --frozen-lockfile

COPY prisma ./prisma
COPY packages ./packages
COPY apps ./apps
COPY docker/entrypoint-dev.sh ./docker/entrypoint-dev.sh

RUN chmod +x ./docker/entrypoint-dev.sh \
  && pnpm db:generate \
  && pnpm --filter @forma/types build

EXPOSE 3000 8081 19000 19001 19002

ENTRYPOINT ["./docker/entrypoint-dev.sh"]
